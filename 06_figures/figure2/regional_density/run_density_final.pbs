#!/bin/bash
#PBS -N mitoevo_regdens_5ct_v1
#PBS -l nodes=1:ppn=2
#PBS -l mem=16gb
#PBS -l walltime=08:00:00
#PBS -j oe
set -euo pipefail
ROOT=/PATH/TO/pbmc.mt
JOB=$ROOT/code/regional_density_final_five_celltypes_20261107_v1
mkdir -p "$JOB/Tables" "$JOB/Figures"
exec > "$JOB/Logs/regional_density_final.log" 2>&1
cd "$JOB"
g++ -O2 -std=c++11 Code/scan_coverage_positions.cpp -lz -o scan_coverage_positions
for sp in human mouse rat chicken cobra sturgeon stingray; do
  echo "START $sp $(date)"
  Rscript Code/prepare_species.R "$sp" "$JOB"
  case "$sp" in
    human) cov="$ROOT/SNP/human/mgatk_newCleanBam/merge_pbmc_samples/final/merged.coverage.txt.gz"; suffix=0 ;;
    *) cov="$ROOT/SNP/$sp/mgatk_newCleanBam/final/$sp.mgatk.coverage.txt.gz"; suffix=0 ;;
  esac
  test -s "$cov"
  ./scan_coverage_positions "$cov" "$JOB/${sp}.barcode_map.tsv" \
    "$JOB/${sp}.positive_positions.tsv" "$JOB/${sp}.matched_barcodes.tsv" "$suffix"
  echo "DONE $sp $(date)"
done
Rscript Code/finalize_density.R
